<?xml version="1.0"?>
<package format="3">

  <name>sentinel_arm_description</name>
  <version>0.1.0</version>

  <description>
    Robot description and RViz visualisation package for the Sentinel Arm.
  </description>

  <maintainer email="omaralbasri03@gmail.com">
    Omar Albasri
  </maintainer>

  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_simulation_gz</exec_depend>
  <exec_depend>robotiq_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>